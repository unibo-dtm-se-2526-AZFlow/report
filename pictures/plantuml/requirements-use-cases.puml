@startuml
left to right direction

actor Patient
actor Operator
actor "External appointment source" as AppointmentSource
actor "Waiting-room display" as WaitingDisplay
actor "Room display" as RoomDisplay

rectangle AZFlow {
    usecase "Check in" as CheckIn
    usecase "Retrieve appointments" as RetrieveAppointments
    usecase "View queue" as ViewQueue
    usecase "Call next patient" as CallNext
    usecase "Call specific patient" as CallSpecific
    usecase "Suspend service access" as Suspend
    usecase "Restore service access" as Restore
    usecase "Confirm admission" as Admit
    usecase "Cancel call" as Cancel
    usecase "Recall patient" as Recall
    usecase "Show waiting-room calls" as ShowWaiting
    usecase "Show room call" as ShowRoom
}

Patient --> CheckIn
CheckIn ..> RetrieveAppointments : <<include>>
AppointmentSource --> RetrieveAppointments

Operator --> ViewQueue
Operator --> CallNext
Operator --> CallSpecific
Operator --> Suspend
Operator --> Restore
Operator --> Admit
Operator --> Cancel
Operator --> Recall

WaitingDisplay --> ShowWaiting
RoomDisplay --> ShowRoom
@enduml
