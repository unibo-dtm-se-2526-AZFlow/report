@startuml
hide methods
hide stereotypes
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam ArrowColor #637386
skinparam classBorderColor #8191A4
skinparam classFontColor #283443
skinparam backgroundColor white
skinparam nodesep 36
skinparam ranksep 48
left to right direction

title AZFlow - Main persistent data relationships

entity "external_source" as external_source #EAF3FE {
  * id : int <<PK>>
  --
  code : text
}
entity "external_agenda" as external_agenda #EAF3FE {
  * id : int <<PK>>
  --
  external_source_id : int <<FK>>
  agenda_id : int <<FK>>
  external_reference : text
}
entity "appointment" as appointment #EAF3FE {
  * id : int <<PK>>
  --
  external_agenda_id : int <<FK>>
  scheduled_at : timestamp
}
entity "agenda" as agenda #F0EDFB {
  * id : int <<PK>>
  --
  name : text
}
entity "queue_agenda" as queue_agenda #F0EDFB {
  * queue_id : int <<PK, FK>>
  * agenda_id : int <<PK, FK>>
}
entity "queue" as queue #F0EDFB {
  * id : int <<PK>>
  --
  policy : text <<FK>>
  ticket_master_id : int <<FK>>
  status : text
}
entity "queue_policy" as queue_policy #F0EDFB {
  * code : text <<PK>>
  --
  label : text
}
entity "ticket_master" as ticket_master #F0EDFB {
  * id : int <<PK>>
  --
  prefix : text
}
entity "ticket_sequence" as ticket_sequence #F0EDFB {
  * ticket_master_id : int <<PK, FK>>
  * operational_day : date <<PK>>
  --
  last_number : int
}
entity "daily_presence" as daily_presence #FFF3D9 {
  * id : int <<PK>>
  --
  operational_day : date
  ticket_master_id : int <<FK>>
  totem_id : int <<FK>>
  public_call_code : text
  checked_in_at : timestamp
}
entity "service_access" as service_access #FFE5B5 {
  * id : int <<PK>>
  --
  daily_presence_id : int <<FK>>
  appointment_id : int <<FK>>
  agenda_id : int <<FK>>
  room_id : int <<FK>>
  state : text
}
entity "service_access_transition" as service_access_transition #FFF3D9 {
  * id : int <<PK>>
  --
  service_access_id : int <<FK>>
  queue_id : int <<FK>>
  occurred_at : timestamp
  previous_state : text
  resulting_state : text
}
entity "location_node" as location_node #EAF7EF {
  * id : int <<PK>>
  --
  parent_id : int <<FK>>
  label : text
}
entity "totem" as totem #EAF7EF {
  * id : int <<PK>>
  --
  location_node_id : int <<FK>>
}
entity "room" as room #EAF7EF {
  * id : int <<PK>>
  --
  location_node_id : int <<FK>>
  room_reference : text
}

entity "room_monitor" as room_monitor #EAF7EF {
  * id : int <<PK>>
  --
  room_id : int <<FK, UNIQUE>>
}
entity "waiting_room_monitor" as waiting_room_monitor #EAF7EF {
  * id : int <<PK>>
  --
  label : text
}

' Relationships in ER notation
external_source ||--o{ external_agenda
agenda ||--o{ external_agenda
external_agenda ||--o{ appointment

appointment |o--o{ service_access
agenda ||--o{ service_access
daily_presence ||--o{ service_access
room |o--o{ service_access

service_access ||--o{ service_access_transition
queue |o--o{ service_access_transition

queue_policy ||--o{ queue
ticket_master ||--o{ queue
queue ||--o{ queue_agenda
agenda ||--o{ queue_agenda

ticket_master ||--o{ daily_presence
ticket_master ||--o{ ticket_sequence

location_node |o--o{ location_node : parent
location_node ||--o{ room
location_node ||--o{ totem
totem |o--o{ daily_presence
room ||--o| room_monitor
waiting_room_monitor }o--o{ location_node : scope
@enduml
